# Embedding provider selection for manual experiments
# EMBEDDING_PROVIDER=mock
# EMBEDDING_PROVIDER=local
# EMBEDDING_PROVIDER=openai

# Optional: set cache directories for the local multilingual embedder
# HF_HOME=./.hf-cache
# SENTENCE_TRANSFORMERS_HOME=./.sentence-transformers

# Optional: OpenAI embedding configuration
# OPENAI_API_KEY=your-key-here
# OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Optional: for ChromaDB persistence (bonus task)
# CHROMA_PERSIST_DIR=./chroma_data

# =====================================================================
# Advanced UIT RAG pipeline (src/rag_pipeline.py, bench.py) — Phase 3+
# Requires: python -m pip install -r requirements-rag.txt
# =====================================================================

# --- Embedding backend used to build/query the UIT vector index ---
# Only "local" is supported for src.rag_embeddings.LocalRAGEmbedder.
# DeepSeek is NEVER used to produce embeddings.
# EMBEDDING_PROVIDER=
# Preferred model for the high_accuracy strategy. Falls back explicitly
# (with a logged warning) to
# sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2 if this model
# cannot be loaded (missing dependency, no network, out of memory, ...).
# EMBEDDING_MODEL=
# Seconds to wait for a model download/load before giving up and falling back
# (protects against a stalled download of a large model hanging forever).
# EMBEDDING_LOAD_TIMEOUT_S=120

# --- DeepSeek (generation only — never used for embeddings) ---
# Get a key at https://platform.deepseek.com/. NEVER commit a real key.
# DEEPSEEK_API_KEY=
# DEEPSEEK_BASE_URL=
# deepseek-v4-flash (default) or deepseek-v4-pro
# DEEPSEEK_MODEL=
